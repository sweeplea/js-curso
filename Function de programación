// 2. Mostrar "¡Hola, [nombre]!" en la consola
function saludar(nombre) {
  console.log(`¡Hola, ${nombre}!`);
}
saludar("Arley");

// 3. Recibir un número y devolver el doble de ese número
function dobleNumero(numero) {
  return numero * 2;
}
console.log(dobleNumero(5));

// 4. Recibir tres números y devolver su promedio
function promedio(a, b, c) {
  return (a + b + c) / 3;
}
console.log(promedio(4, 8, 12));

// 5. Recibir dos números y devolver el mayor de ellos
function mayorNumero(a, b) {
  return a > b ? a : b;
}
console.log(mayorNumero(10, 7));

// 6. Recibir un número y devolver el resultado de multiplicar ese número por sí mismo
function cuadradoNumero(numero) {
  return numero * numero;
}
console.log(cuadradoNumero(6));

